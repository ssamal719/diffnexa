{
  "$defs": {
    "AIAnnotation": {
      "additionalProperties": false,
      "description": "AI commentary on one existing change. Deliberately has no value or evidence fields.",
      "properties": {
        "action_required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Required"
        },
        "change_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Change Id",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "explanation": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explanation"
        },
        "impact": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Impact"
        },
        "importance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Importance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "needs_review": {
          "default": false,
          "title": "Needs Review",
          "type": "boolean"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "change_id",
        "confidence"
      ],
      "title": "AIAnnotation",
      "type": "object"
    },
    "BBox": {
      "additionalProperties": false,
      "properties": {
        "x0": {
          "title": "X0",
          "type": "number"
        },
        "x1": {
          "title": "X1",
          "type": "number"
        },
        "y0": {
          "title": "Y0",
          "type": "number"
        },
        "y1": {
          "title": "Y1",
          "type": "number"
        }
      },
      "required": [
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "title": "BBox",
      "type": "object"
    },
    "Change": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/ChangeCategory"
        },
        "confidence": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "delta": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delta"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ChangeKind"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "new_value": {
          "anyOf": [
            {
              "maxLength": 5000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "New Value"
        },
        "noise_reason": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Noise Reason"
        },
        "old_value": {
          "anyOf": [
            {
              "maxLength": 5000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Old Value"
        },
        "rule_importance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Importance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "subtype": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subtype"
        }
      },
      "required": [
        "id",
        "seq",
        "kind",
        "category",
        "evidence"
      ],
      "title": "Change",
      "type": "object"
    },
    "ChangeCategory": {
      "enum": [
        "text",
        "number",
        "date",
        "identifier",
        "table",
        "image",
        "page",
        "link",
        "metadata",
        "formatting",
        "layout"
      ],
      "title": "ChangeCategory",
      "type": "string"
    },
    "ChangeKind": {
      "enum": [
        "added",
        "removed",
        "modified",
        "moved"
      ],
      "title": "ChangeKind",
      "type": "string"
    },
    "DocumentRef": {
      "additionalProperties": false,
      "description": "One side of a comparison, when that side is a paginated document.",
      "properties": {
        "kind": {
          "const": "document",
          "default": "document",
          "title": "Kind",
          "type": "string"
        },
        "page_count": {
          "minimum": 1,
          "title": "Page Count",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "page_count"
      ],
      "title": "DocumentRef",
      "type": "object"
    },
    "DocxRef": {
      "additionalProperties": false,
      "description": "One side of a comparison, when that side is a Word (.docx) document.\n\nA Word document has no fixed pages \u2014 pagination depends on the printer, the\nfonts and the window it is opened in \u2014 so, as for a webpage, no page count\nis recorded. The fingerprint is of the document's content, and it is what\nevery piece of evidence from that document cites.",
      "properties": {
        "kind": {
          "const": "docx",
          "default": "docx",
          "title": "Kind",
          "type": "string"
        },
        "node_count": {
          "minimum": 0,
          "title": "Node Count",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "node_count"
      ],
      "title": "DocxRef",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "Where a change came from, in terms the source format can actually answer.\n\nThree scopes, and a piece of evidence uses exactly one of them:\n\n* ``page`` \u2014 a place on a page of a document: a page number, plus the words\n  or the area on it. This is what PDFs can prove.\n* ``document`` \u2014 a property of the file as a whole, such as its title. Only\n  metadata changes may use it.\n* ``node`` \u2014 a place in a captured webpage: the snapshot it came from, the\n  content node, and the words cited within that node. A webpage has no pages\n  and no coordinates, so inventing them would be inventing evidence.\n\nThe fields of one scope are forbidden on the others, checked below, so page\nevidence can never quietly become node evidence or the reverse.",
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "excerpt": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "field": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "node_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node Id"
        },
        "node_path": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Node Path"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "scope": {
          "default": "page",
          "enum": [
            "page",
            "document",
            "node"
          ],
          "title": "Scope",
          "type": "string"
        },
        "section_path": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Section Path",
          "type": "array"
        },
        "side": {
          "$ref": "#/$defs/Side"
        },
        "snapshot_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Snapshot Sha256"
        },
        "text_range": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Range"
        },
        "token_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Token Ids",
          "type": "array"
        },
        "word_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Word Ids",
          "type": "array"
        }
      },
      "required": [
        "side"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Importance": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "informational"
      ],
      "title": "Importance",
      "type": "string"
    },
    "Side": {
      "enum": [
        "old",
        "new"
      ],
      "title": "Side",
      "type": "string"
    },
    "SnapshotRef": {
      "additionalProperties": false,
      "description": "One side of a comparison, when that side is a captured webpage.\n\nA webpage has no pages, so there is no page count here. Inventing one to fit\nthe document shape would put a number in the result that nothing could\nverify. What a snapshot does have is the address it came from and how much\ncontent was found, and those are recorded instead.",
      "properties": {
        "kind": {
          "const": "snapshot",
          "default": "snapshot",
          "title": "Kind",
          "type": "string"
        },
        "node_count": {
          "minimum": 0,
          "title": "Node Count",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "url": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "url",
        "node_count"
      ],
      "title": "SnapshotRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "annotations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AIAnnotation"
      },
      "title": "Annotations",
      "type": "array"
    },
    "changes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Change"
      },
      "title": "Changes",
      "type": "array"
    },
    "engine_version": {
      "title": "Engine Version",
      "type": "string"
    },
    "new_document": {
      "discriminator": {
        "mapping": {
          "document": "#/$defs/DocumentRef",
          "docx": "#/$defs/DocxRef",
          "snapshot": "#/$defs/SnapshotRef"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/DocumentRef"
        },
        {
          "$ref": "#/$defs/SnapshotRef"
        },
        {
          "$ref": "#/$defs/DocxRef"
        }
      ],
      "title": "New Document"
    },
    "old_document": {
      "discriminator": {
        "mapping": {
          "document": "#/$defs/DocumentRef",
          "docx": "#/$defs/DocxRef",
          "snapshot": "#/$defs/SnapshotRef"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/DocumentRef"
        },
        {
          "$ref": "#/$defs/SnapshotRef"
        },
        {
          "$ref": "#/$defs/DocxRef"
        }
      ],
      "title": "Old Document"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "engine_version",
    "old_document",
    "new_document"
  ],
  "title": "ComparisonResult",
  "type": "object"
}
