{
  "name": "diffnexa-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync:contracts": "node scripts/sync-contracts.mjs",
    "prepare:assets": "node scripts/sync-contracts.mjs && node scripts/copy-pdf-worker.mjs",
    "dev": "npm run prepare:assets && next dev",
    "build": "npm run prepare:assets && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run prepare:assets && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "^5.3.0",
    "next": "16.3.4",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
