     ]
    },
    {
     "id": "n6",
     "role": "paragraph",
     "text": "Invoices are payable within 30 days of issue. Late payment may result in suspension of the service until the overdue amount is settled.",
     "section": [
      "Terms of Service",
      "Payment terms"
     ]
    },
    {
     "id": "n7",
     "role": "heading",
     "text": "Refunds",
     "level": 2,
     "section": [
      "Terms of Service"
     ]
    },
    {
     "id": "n8",
     "role": "paragraph",
     "text": "Our refund policy allows a full refund if you cancel within 14 days of your first payment. After that period fees are non-refundable.",
     "section": [
      "Terms of Service",
      "Refunds"
     ]
    },
    {
     "id": "n9",
     "role": "heading",
     "text": "Cancellation and termination",
     "level": 2,
     "section": [
      "Terms of Service"
     ]
    },
    {
     "id": "n10",
     "role": "paragraph",
     "text": "You may cancel your subscription at any time by giving 30 days written notice. We may terminate this agreement if you materially breach these terms.",
     "section": [
      "Terms of Service",
      "Cancellation and termination"
     ]
    },
    {
     "id": "n11",
     "role": "heading",
     "text": "Automatic renewal",
     "level": 2,
     "section": [
      "Terms of Service"
     ]
    },
    {
     "id": "n12",
     "role": "paragraph",
     "text": "Your subscription renews automatically for a further twelve months unless you cancel before the renewal date.",
     "section": [
      "Terms of Service",
      "Automatic renewal"
     ]
    },
    {
