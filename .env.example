# Copy this file to .env and fill in values as each stage needs them.
# Never commit .env — it is ignored by git.

# ---------------------------------------------------------------- Stage 1
# Nothing is required. Stage 1 runs entirely on your own computer.

# Limits. These are safety ceilings; per-plan limits (Stage 10) are lower.
DIFFNEXA_MAX_FILE_MB=50
DIFFNEXA_MAX_PAGES=500

# Public address of the site, used for canonical URLs and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------- Engine connection
# Where the comparison engine is running. No trailing slash: the site appends
# /v1/compare and /healthz itself.
ENGINE_URL=http://127.0.0.1:8000

# Shared secret proving a request came from this site. Set the SAME value on the
# website and on the engine. Server-side only — never prefix it NEXT_PUBLIC_,
# and never paste it into a chat, an issue or a commit.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# When it is unset the engine accepts requests from anyone who can reach it,
# which is fine on your own computer and not fine on the public internet.
# ENGINE_SHARED_SECRET=

# How long to wait for the engine's health check, in milliseconds. The default
# of 60000 is deliberately generous: a hosting plan that puts idle instances to
# sleep can take most of a minute to wake up, and a shorter wait would wrongly
# report a healthy engine as unavailable.
# ENGINE_HEALTH_TIMEOUT_MS=60000

# How long to wait for a comparison, in milliseconds. Default 120000.
# ENGINE_TIMEOUT_MS=120000

# ---------------------------------------------------------------- Later stages
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=      # safe in the browser
# SUPABASE_SECRET_KEY=           # server only — never expose to the browser

# ---------------------------------------------------------------- Stage 8 (later)
# AI_PROVIDER=gemini
# AI_ENABLED=false               # the product works fully with AI switched off
# GEMINI_API_KEY=                # server only, stored in Secret Manager
# AI_MODEL_DEFAULT=
# AI_DAILY_BUDGET_USD=2
