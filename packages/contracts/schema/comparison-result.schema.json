{
  "$defs": {
    "AIAnnotation": {
      "additionalProperties": false,
      "description": "AI commentary on one existing change. Deliberately has no value or evidence fields.",
      "properties": {
        "action_required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Required"
        },
        "change_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Change Id",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "explanation": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Explanation"
        },
        "impact": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Impact"
        },
        "importance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Importance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "needs_review": {
          "default": false,
          "title": "Needs Review",
          "type": "boolean"
        },
        "title": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        }
      },
      "required": [
        "change_id",
        "confidence"
      ],
      "title": "AIAnnotation",
      "type": "object"
    },
    "BBox": {
      "additionalProperties": false,
      "properties": {
        "x0": {
          "title": "X0",
          "type": "number"
        },
        "x1": {
          "title": "X1",
          "type": "number"
        },
        "y0": {
          "title": "Y0",
          "type": "number"
        },
        "y1": {
          "title": "Y1",
          "type": "number"
        }
      },
      "required": [
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "title": "BBox",
      "type": "object"
    },
    "Change": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "$ref": "#/$defs/ChangeCategory"
        },
        "confidence": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "delta": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delta"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ChangeKind"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "new_value": {
          "anyOf": [
            {
              "maxLength": 5000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "New Value"
        },
        "noise_reason": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Noise Reason"
        },
        "old_value": {
          "anyOf": [
            {
              "maxLength": 5000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Old Value"
        },
        "rule_importance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Importance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "subtype": {
          "anyOf": [
            {
              "maxLength": 50,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subtype"
        }
      },
      "required": [
        "id",
        "seq",
        "kind",
        "category",
        "evidence"
      ],
      "title": "Change",
      "type": "object"
    },
    "ChangeCategory": {
      "enum": [
        "text",
        "number",
        "date",
        "identifier",
        "table",
        "image",
        "page",
        "link",
        "metadata",
        "formatting",
        "layout"
      ],
      "title": "ChangeCategory",
      "type": "string"
    },
    "ChangeKind": {
      "enum": [
        "added",
        "removed",
        "modified",
        "moved"
      ],
      "title": "ChangeKind",
      "type": "string"
    },
    "DocumentRef": {
      "additionalProperties": false,
      "properties": {
        "page_count": {
          "minimum": 1,
          "title": "Page Count",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "page_count"
      ],
      "title": "DocumentRef",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/BBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "excerpt": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "field": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "scope": {
          "default": "page",
          "enum": [
            "page",
            "document"
          ],
          "title": "Scope",
          "type": "string"
        },
        "side": {
          "$ref": "#/$defs/Side"
        },
        "word_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Word Ids",
          "type": "array"
        }
      },
      "required": [
        "side"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Importance": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "informational"
      ],
      "title": "Importance",
      "type": "string"
    },
    "Side": {
      "enum": [
        "old",
        "new"
      ],
      "title": "Side",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "annotations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/AIAnnotation"
      },
      "title": "Annotations",
      "type": "array"
    },
    "changes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Change"
      },
      "title": "Changes",
      "type": "array"
    },
    "engine_version": {
      "title": "Engine Version",
      "type": "string"
    },
    "new_document": {
      "$ref": "#/$defs/DocumentRef"
    },
    "old_document": {
      "$ref": "#/$defs/DocumentRef"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "engine_version",
    "old_document",
    "new_document"
  ],
  "title": "ComparisonResult",
  "type": "object"
}
